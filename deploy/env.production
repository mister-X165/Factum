# ============================================================================
# Factum — шаблон продакшен-окружения сервера.
#
# Скопируйте на сервер как /opt/factum/app/.env и заполните значения:
#   cp deploy/env.production /opt/factum/app/.env && nano /opt/factum/app/.env
#
# systemd подхватывает этот файл целиком (EnvironmentFile в factum.service).
# ============================================================================

# --- База данных: ТОЛЬКО абсолютный путь (см. комментарий в .env.example) ---
# Каталог должен существовать: mkdir -p /opt/factum/app/db && chown factum:factum /opt/factum/app/db
DATABASE_URL="file:/opt/factum/app/db/factum.db"

# --- Аутентификация ---------------------------------------------------------
# Сгенерировать: openssl rand -hex 32   (уникально для этого сервера!)
AUTH_SECRET=""
# Первый admin-аккаунт создаётся автоматически при старте на пустой БД.
ADMIN_USERNAME="admin"
# ОБЯЗАТЕЛЬНО задайте пароль — иначе admin/admin с предупреждением в логе.
ADMIN_PASSWORD=""

# --- LLM: Groq, прямое подключение (вариант A) ------------------------------
LLM_PROVIDER="groq"
LLM_API_KEY="gsk_YOUR_GROQ_KEY_HERE"
LLM_MODEL="qwen/qwen3.8-27b"
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_RESPONSE_FORMAT="json_object"
LLM_TIMEOUT_MS="120000"
LLM_IDLE_TIMEOUT_MS="60000"
# 1000 маловато для этапа report (риск обрезки JSON) — ставим 3000.
LLM_MAX_TOKENS="3000"

# --- Поиск источников --------------------------------------------------------
SEARCH_PROVIDER="auto"
