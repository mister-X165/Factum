# ============================================================================
# Factum — production-конфиг Caddy (reverse proxy + автоматический TLS).
#
# Установка: скопируйте на сервер как /etc/caddy/Caddyfile и замените
# demo.example.com на ваш домен (DNS A-запись должна указывать на сервер).
# Затем: systemctl reload caddy
#
# Caddy сам выпустит и будет продлевать сертификат Let's Encrypt (нужен
# открытый 80 и 443 порт). Для проверки по IP/без домена см. блок ниже.
# ============================================================================

demo.example.com {
	# --- SSE: выключаем буферизацию и держим соединение открытым ---
	# Без flush_interval -1 Caddy буферизирует поток и /api/analyze
	# «замирает» — события приходят пачками в конце, heartbeat'ы не проходят.
	reverse_proxy 127.0.0.1:3000 {
		flush_interval -1
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	# Здравствуй, HSTS (можно оставить как есть):
	header Strict-Transport-Security "max-age=31536000"
}

# ----------------------------------------------------------------------------
# Вариант БЕЗ домена (только HTTP, TLS не выдаётся) — раскомментируйте вместо
# блока выше, если сервер доступен по IP или внутреннему имени:
# ----------------------------------------------------------------------------
# :80 {
# 	reverse_proxy 127.0.0.1:3000 {
# 		flush_interval -1
# 		header_up X-Forwarded-For {remote_host}
# 		header_up X-Forwarded-Proto {scheme}
# 	}
# }
