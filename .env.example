# ============================================================================
# Factum — шаблон переменных окружения.
# Скопируйте в .env и заполните:  cp .env.example .env
#
# НИКОГДА не коммитьте настоящий .env в git (он уже в .gitignore)
# и не кладите его в публичные архивы.
# ============================================================================

# ----------------------------------------------------------------------------
# База данных (SQLite через Prisma).
#
# ВАЖНО про пути: Prisma разрешает ОТНОСИТЕЛЬНЫЙ путь file:./… относительно
# каталога, где лежит prisma/schema.prisma. То есть "file:./db/custom.db"
# создаст файл в prisma/db/custom.db, а НЕ в db/ — и не совпадёт с
# ReadWritePaths в systemd-юните.
#
# В ПРОДАКШЕНЕ ВСЕГДА указывайте АБСОЛЮТНЫЙ путь:
#   DATABASE_URL="file:/opt/factum/app/db/factum.db"
# (каталог /opt/factum/app/db должен существовать и быть доступен на запись
#  пользователю сервиса; см. deploy/factum.service → ReadWritePaths).
# ----------------------------------------------------------------------------

# Локальная разработка (файл появится в prisma/db/custom.db):
DATABASE_URL="file:./db/custom.db"
# Продакшен (раскомментируйте и подставьте свой путь):
# DATABASE_URL="file:/opt/factum/app/db/factum.db"

# ----------------------------------------------------------------------------
# Аутентификация.
#
# AUTH_SECRET — ключ HMAC-SHA256 для подписи session-куки. ОБЯЗАТЕЛЕН:
# без него POST /api/login вернёт «Сбой генерации session-токена».
# Сгенерируйте уникальное значение ОДИН раз на каждое окружение:
#   openssl rand -hex 32
# Смена AUTH_SECRET инвалидирует все активные сессии (users must re-login).
# ----------------------------------------------------------------------------

AUTH_SECRET=""
ADMIN_USERNAME="admin"
# Пароль первого admin-аккаунта, создаётся автоматически при пустой таблице
# User. Если оставить пустым — будет создан admin/admin с предупреждением в
# логе. ОБЯЗАТЕЛЬНО задайте свой пароль перед первым запуском.
ADMIN_PASSWORD=""

# ----------------------------------------------------------------------------
# LLM-провайдер (OpenAI-совместимый протокол /chat/completions).
#
# Ниже — конфигурация для Groq (вариант «A: прямое подключение к облаку»).
# Ключ брать в https://console.groq.com/api/keys
#
# Проверить, что модель доступна вашему ключу:
#   curl -s https://api.groq.com/openai/v1/models \
#     -H "Authorization: Bearer $LLM_API_KEY" | head -100
#
# Модель qwen/qwen3.8-27b — флагман Groq. Резервные варианты: openai/gpt-oss-120b,
# openai/gpt-oss-20b. Актуальный список моделей: https://console.groq.com/docs/models
# ----------------------------------------------------------------------------

LLM_PROVIDER="groq"
LLM_API_KEY=""
LLM_MODEL="qwen/qwen3.8-27b"
LLM_BASE_URL="https://api.groq.com/openai/v1"
# json_object — единственный режим, который у Groq работает вместе со
# стримингом (json_schema у Groq со стримингом не поддерживается; код сам
# понижает схему до json_object на облачных бэкендах).
LLM_RESPONSE_FORMAT="json_object"
# Таймауты/лимиты (значения по умолчанию подходят для облачных моделей):
LLM_TIMEOUT_MS="120000"
LLM_IDLE_TIMEOUT_MS="60000"
# max_tokens на ОДИН LLM-вызов. 1000 может обрезать JSON на этапе отчёта
# (report содержит сводку по всем утверждениям). Рекомендуется 2000–4096.
LLM_MAX_TOKENS="3000"
# Температура сэмплинга (0.0 — детерминированно, 0.3 — баланс для factcheck):
LLM_TEMPERATURE="0.3"

# Доп. заголовки для OpenRouter и др. (JSON или "Key: Value" по строкам):
# LLM_HEADERS_JSON='{"HTTP-Referer":"https://your-site","X-Title":"Factum"}'

# ----------------------------------------------------------------------------
# Поиск источников (без API-ключей): auto = DuckDuckGo → Bing.
# SEARCH_PROVIDER="auto"        # auto | duckduckgo | bing
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Отладка SQL-логов в dev-режиме:
# LOG_QUERIES="1"
# ----------------------------------------------------------------------------
