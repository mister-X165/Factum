# ===== База данных (SQLite, локальная) =====
# Путь — с ПРЯМЫМИ слешами, даже на Windows.
# Относительный путь: БД создастся в папке db/ рядом с проектом после `bun run db:push`.
DATABASE_URL=file:./db/custom.db

# ============================================================
#   ЛОКАЛЬНЫЙ LLM-провайдер (llama.cpp / LM Studio / Ollama)
# ============================================================
# Выбор провайдера: lm-studio | llama-cpp | ollama | zai
LLM_PROVIDER=lm-studio

# Базовый URL OpenAI-совместимого локального сервера.
# Если оставить пустым — подставится дефолт для выбранного провайдера:
#   lm-studio → http://127.0.0.1:1234/v1
#   llama-cpp → http://127.0.0.1:8080/v1
#   ollama    → http://127.0.0.1:11434/v1
# Заполните только если используете нестандартный порт/хост:
# LLM_BASE_URL=http://127.0.0.1:1234/v1

# API-ключ локального сервера.
# LM Studio и llama.cpp обычно не требуют ключа — можно оставить "lm-studio".
# Ollama тоже не требует. Заполняйте только если ваш сервер требует авторизацию.
LLM_API_KEY=lm-studio

# Имя модели.
# LM Studio: можно оставить пустым — используется загруженная модель.
# Ollama: укажите имя, например "llama3.1" или "qwen2.5:7b".
# llama.cpp: можно оставить пустым.
LLM_MODEL=

# ============================================================
#   ТАЙМАУТЫ LLM (повышены для медленных локальных моделей)
# ============================================================
# Жёсткий потолок ОДНОГО LLM-запроса (миллисекунды).
# Теперь LLM-клиент стримит ответ и сбрасывает idle-таймер на каждом чанке,
# поэтому этот таймаут можно ставить щедро — он сработает только если модель
# действительно зависла или генерация идёт дольше потолка.
# 600000 мс = 10 минут. Для ~5 ток/с модели на 4-кило-контексте этого хватает
# с запасом. Если используете очень тяжёлую модель — поднимите до 900000 (15 мин).
LLM_TIMEOUT_MS=600000

# Idle-таймаут: если стрим не отдаёт ни одного байта это время — запрос
# прерывается (модель зависла / упала). На каждый полученный чанк таймер
# сбрасывается, поэтому медленная но живая модель НЕ убивается.
# 90000 мс = 90 секунд. Для очень тяжёлых моделей с медленным префиллом
# можно поднять до 120000–180000.
LLM_IDLE_TIMEOUT_MS=90000

# Лимит генерации токенов на один запрос. Не даёт модели уйти в бесконечный
# пространный ответ. 4096 покрывает ~12 claim-объектов с полными полями.
LLM_MAX_TOKENS=4096

# ============================================================
#   Веб-поиск и загрузка URL — БЕЗ z-ai
# ============================================================
# Поиск источников идёт через Bing (HTML-парсинг, без API-ключа),
# как в исходном приложении Grafix (graph/websearch.py, пакет ddgs).
# Загрузка страниц по URL — прямой HTTP-запрос + извлечение текста из HTML.
# Никаких внешних ключей и облачных сервисов не требуется.
