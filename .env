# ============================================================
#   ФАКТУМ — переменные окружения
#   Если приложение слетит, проверьте/введите эти значения вручную.
# ============================================================

# ===== База данных (SQLite, локальная) =====
# Путь к файлу БД. С ПРЯМЫМИ слешами, даже на Windows.
# Относительный путь: БД в папке db/ рядом с проектом (после `bun run db:push`).
DATABASE_URL=file:./db/custom.db

# ============================================================
#   ЛОКАЛЬНЫЙ LLM-провайдер
# ============================================================
# Выбор провайдера: lm-studio | llama-cpp | ollama
LLM_PROVIDER=lm-studio

# Базовый URL OpenAI-совместимого локального сервера.
# Если оставить пустым/закомментированным — подставится дефолт:
#   lm-studio → http://127.0.0.1:1234/v1
#   llama-cpp → http://127.0.0.1:8080/v1
#   ollama    → http://127.0.0.1:11434/v1
# Раскомментируйте и впишите только если порт/хост нестандартный:
# LLM_BASE_URL=http://127.0.0.1:1234/v1

# API-ключ локального сервера.
# LM Studio / llama.cpp / Ollama обычно не требуют ключа — оставьте "lm-studio".
# Заполняйте только если сервер требует авторизацию.
LLM_API_KEY=lm-studio

# Имя модели.
# LM Studio / llama.cpp — можно оставить пустым (используется загруженная модель).
# Ollama — укажите имя, например "llama3.1" или "qwen2.5:7b".
LLM_MODEL=

# ============================================================
#   ТАЙМАУТЫ LLM (повышены для медленных локальных моделей)
#   Все значения в миллисекундах.
# ============================================================

# Жёсткий потолок ОДНОГО LLM-запроса.
# LLM-клиент стримит ответ и сбрасывает idle-таймер на каждом чанке,
# поэтому этот таймаут сработает только если генерация идёт дольше потолка.
# 600000 мс = 10 минут. Для очень тяжёлой модели поднимите до 900000 (15 мин).
LLM_TIMEOUT_MS=600000

# Idle-таймаут: если стрим не отдаёт ни одного байта это время —
# запрос прерывается (модель зависла). На каждый чанк таймер сбрасывается,
# поэтому медленная но живая модель НЕ убивается.
# 90000 мс = 90 секунд. Для тяжёлых моделей с медленным префиллом — 120000–180000.
LLM_IDLE_TIMEOUT_MS=90000

# Лимит генерации токенов на один запрос.
# Не даёт модели уйти в бесконечный ответ. 4096 покрывает ~12 claim-объектов.
LLM_MAX_TOKENS=4096

# ============================================================
#   Веб-поиск и загрузка URL — БЕЗ внешних API-ключей.
#   Поиск через Bing (HTML-парсинг), загрузка — прямой HTTP.
# ============================================================
